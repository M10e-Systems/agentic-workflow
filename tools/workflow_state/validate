#!/usr/bin/env python3
import json
import os
import sys


def load_json(path):
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def _is_type(value, type_name):
    if type_name == "object":
        return isinstance(value, dict)
    if type_name == "array":
        return isinstance(value, list)
    if type_name == "string":
        return isinstance(value, str)
    if type_name == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if type_name == "number":
        return (isinstance(value, int) or isinstance(value, float)) and not isinstance(value, bool)
    if type_name == "boolean":
        return isinstance(value, bool)
    if type_name == "null":
        return value is None
    return False


def _type_ok(value, schema):
    if "type" not in schema:
        return True
    schema_type = schema["type"]
    if isinstance(schema_type, list):
        return any(_is_type(value, t) for t in schema_type)
    return _is_type(value, schema_type)


def validate_schema(schema, data, path="$"):
    errors = []

    if not _type_ok(data, schema):
        expected = schema.get("type", "any")
        errors.append(f"{path}: expected {expected}")
        return errors

    if "enum" in schema and data not in schema["enum"]:
        errors.append(f"{path}: value {data!r} not in enum {schema['enum']}")

    if schema.get("type") == "object":
        required = schema.get("required", [])
        for key in required:
            if key not in data:
                errors.append(f"{path}: missing required key '{key}'")

        properties = schema.get("properties", {})
        for key, value in data.items():
            if key in properties:
                errors.extend(validate_schema(properties[key], value, f"{path}.{key}"))
            elif schema.get("additionalProperties") is False:
                errors.append(f"{path}: unexpected key '{key}'")

    if schema.get("type") == "array":
        items_schema = schema.get("items")
        if items_schema is not None:
            for index, item in enumerate(data):
                errors.extend(validate_schema(items_schema, item, f"{path}[{index}]"))

    return errors


def main(argv):
    if len(argv) != 2:
        print("Usage: validate <path>", file=sys.stderr)
        return 2

    json_path = argv[1]
    if not os.path.exists(json_path):
        print(f"Missing file: {json_path}", file=sys.stderr)
        return 2

    script_dir = os.path.dirname(os.path.abspath(__file__))
    schema_path = os.path.abspath(os.path.join(script_dir, "..", "..", "docs", "workflow_state_schema.json"))

    try:
        schema = load_json(schema_path)
    except json.JSONDecodeError as exc:
        print(f"Schema JSON parse error: {exc}", file=sys.stderr)
        return 2

    try:
        data = load_json(json_path)
    except json.JSONDecodeError as exc:
        print(f"State JSON parse error: {exc}", file=sys.stderr)
        return 2

    errors = validate_schema(schema, data)
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    print("OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
