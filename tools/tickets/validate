#!/usr/bin/env python3
import json
import os
import sys


def _is_type(value, type_name):
    if type_name == "object":
        return isinstance(value, dict)
    if type_name == "array":
        return isinstance(value, list)
    if type_name == "string":
        return isinstance(value, str)
    if type_name == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if type_name == "number":
        return (isinstance(value, int) or isinstance(value, float)) and not isinstance(value, bool)
    if type_name == "boolean":
        return isinstance(value, bool)
    if type_name == "null":
        return value is None
    return False


def _type_ok(value, schema):
    if "type" not in schema:
        return True
    schema_type = schema["type"]
    if isinstance(schema_type, list):
        return any(_is_type(value, t) for t in schema_type)
    return _is_type(value, schema_type)


def validate_schema(schema, data, path="$"):
    errors = []

    if not _type_ok(data, schema):
        expected = schema.get("type", "any")
        errors.append(f"{path}: expected {expected}")
        return errors

    if "enum" in schema and data not in schema["enum"]:
        errors.append(f"{path}: value {data!r} not in enum {schema['enum']}")

    if schema.get("type") == "object":
        required = schema.get("required", [])
        for key in required:
            if key not in data:
                errors.append(f"{path}: missing required key '{key}'")

        properties = schema.get("properties", {})
        for key, value in data.items():
            if key in properties:
                errors.extend(validate_schema(properties[key], value, f"{path}.{key}"))
            elif schema.get("additionalProperties") is False:
                errors.append(f"{path}: unexpected key '{key}'")

    if schema.get("type") == "array":
        items_schema = schema.get("items")
        if items_schema is not None:
            for index, item in enumerate(data):
                errors.extend(validate_schema(items_schema, item, f"{path}[{index}]"))

    return errors


def load_json(path):
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def load_yaml(path):
    try:
        import yaml  # type: ignore
    except Exception:
        yaml = None

    with open(path, "r", encoding="utf-8") as handle:
        text = handle.read()

    if yaml is not None:
        return yaml.safe_load(text) or {}

    return parse_simple_yaml(text)


def parse_simple_yaml(text):
    """
    Minimal YAML subset parser:
    - supports mappings, lists, nested objects via indentation (2+ spaces)
    - supports scalars: strings (quoted/unquoted), booleans, null, numbers
    - supports inline lists: [a, b, c]
    Not supported: anchors, multiline scalars, complex keys, tabs.
    """

    def parse_scalar(token):
        token = token.strip()
        if token == "":
            return ""
        if token in ("null", "Null", "NULL", "~"):
            return None
        if token in ("true", "True", "TRUE"):
            return True
        if token in ("false", "False", "FALSE"):
            return False
        if token.startswith("'") and token.endswith("'") and len(token) >= 2:
            return token[1:-1]
        if token.startswith('"') and token.endswith('"') and len(token) >= 2:
            return bytes(token[1:-1], "utf-8").decode("unicode_escape")
        if token.startswith("[") and token.endswith("]"):
            inner = token[1:-1].strip()
            if not inner:
                return []
            parts = [p.strip() for p in inner.split(",")]
            return [parse_scalar(p) for p in parts]
        try:
            if "." in token:
                return float(token)
            return int(token)
        except ValueError:
            return token

    lines = []
    for raw in text.splitlines():
        if not raw.strip():
            continue
        stripped = raw.lstrip(" ")
        if stripped.startswith("#"):
            continue
        if " #" in raw:
            raw = raw.split(" #", 1)[0].rstrip()
            if not raw.strip():
                continue
        indent = len(raw) - len(raw.lstrip(" "))
        if "\t" in raw:
            raise ValueError("Tabs are not supported in YAML")
        lines.append((indent, raw.strip()))

    if not lines:
        return {}

    root = None
    stack = []  # (indent, container)

    def ensure_parent_for(indent):
        nonlocal stack
        while stack and indent <= stack[-1][0]:
            stack.pop()
        return stack[-1][1] if stack else None

    for idx, (indent, content) in enumerate(lines):
        parent = ensure_parent_for(indent)

        if content.startswith("- "):
            item_text = content[2:].strip()
            if parent is None:
                if root is None:
                    root = []
                    stack.append((-1, root))
                    parent = root
                else:
                    raise ValueError("Top-level list mixed with mapping")
            if not isinstance(parent, list):
                raise ValueError("List item under non-list parent")

            if ":" in item_text:
                key, rest = item_text.split(":", 1)
                obj = {key.strip(): parse_scalar(rest.strip()) if rest.strip() else {}}
                parent.append(obj)
                if rest.strip() == "":
                    stack.append((indent, obj[key.strip()]))
                else:
                    stack.append((indent, obj))
            else:
                parent.append(parse_scalar(item_text))
            continue

        if ":" not in content:
            raise ValueError(f"Invalid line (expected key: value): {content}")

        key, rest = content.split(":", 1)
        key = key.strip()
        rest = rest.strip()
        if parent is None:
            if root is None:
                root = {}
            parent = root
            stack = [(-1, root)]

        if not isinstance(parent, dict):
            raise ValueError("Mapping entry under non-mapping parent")

        if rest == "":
            # Lookahead: if the next non-empty line at a deeper indent begins with "- ",
            # treat this as a list container; otherwise treat as a mapping container.
            next_container_is_list = False
            if idx + 1 < len(lines):
                next_indent, next_content = lines[idx + 1]
                if next_indent > indent and next_content.startswith("- "):
                    next_container_is_list = True

            parent[key] = [] if next_container_is_list else {}
            stack.append((indent, parent[key]))
        else:
            parent[key] = parse_scalar(rest)

    return root if root is not None else {}


def validate_ticket_logic(data):
    errors = []

    tickets = data.get("tickets", [])
    by_id = {}
    for index, ticket in enumerate(tickets):
        ticket_id = ticket.get("id")
        if ticket_id in by_id:
            errors.append(f"$.tickets[{index}].id: duplicate ticket id {ticket_id!r}")
        else:
            by_id[ticket_id] = ticket

    for index, ticket in enumerate(tickets):
        blocked_by = ticket.get("blocked_by", [])
        if not isinstance(blocked_by, list):
            continue
        for dep in blocked_by:
            if dep not in by_id:
                errors.append(f"$.tickets[{index}].blocked_by: unknown ticket id {dep!r}")

        status = ticket.get("status")
        if status in ("Ready", "In Progress", "Done", "Accepted"):
            if not ticket.get("code_root"):
                errors.append(f"$.tickets[{index}].code_root: required when status is {status!r}")
            unit_test_commands = ticket.get("unit_test_commands")
            if not isinstance(unit_test_commands, list) or not unit_test_commands:
                errors.append(f"$.tickets[{index}].unit_test_commands: non-empty list required when status is {status!r}")

        # Optional: if claimed_by is set, status should be In Progress.
        if ticket.get("claimed_by") and ticket.get("status") not in ("In Progress", "Done", "Accepted"):
            errors.append(
                f"$.tickets[{index}]: claimed_by is set but status is {ticket.get('status')!r} (expected In Progress/Done/Accepted)"
            )

    return errors


def main(argv):
    if len(argv) != 2:
        print("Usage: validate <path>", file=sys.stderr)
        return 2

    yaml_path = argv[1]
    if not os.path.exists(yaml_path):
        print(f"Missing file: {yaml_path}", file=sys.stderr)
        return 2

    repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
    schema_path = os.path.join(repo_root, "docs", "tickets_schema.json")

    try:
        schema = load_json(schema_path)
    except json.JSONDecodeError as exc:
        print(f"Schema JSON parse error: {exc}", file=sys.stderr)
        return 2

    try:
        data = load_yaml(yaml_path)
    except Exception as exc:
        print(f"YAML parse error: {exc}", file=sys.stderr)
        return 2

    errors = validate_schema(schema, data)
    errors.extend(validate_ticket_logic(data))
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    print("OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
